{
  "name": "super-strikers",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/fetch-seo-settings.js && node scripts/generate-sitemap.js && expo export --platform web && node scripts/inject-favicon.js",
    "build:android": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "seo:settings": "node scripts/fetch-seo-settings.js",
    "seo:sitemap": "node scripts/generate-sitemap.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-device": "~7.0.0",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.4",
    "expo-image": "~2.0.0",
    "expo-image-manipulator": "~13.0.5",
    "expo-image-picker": "~16.0.0",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-sharing": "~13.0.0",
    "expo-status-bar": "~2.0.1",
    "expo-video": "~2.0.0",
    "html2canvas": "^1.4.1",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  }
}
